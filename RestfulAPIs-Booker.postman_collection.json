                  "});\r",
                  "\r",
                  "pm.test(\"Validate that bookingid is returned and not empty\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    \r",
                  "    pm.expect(jsonData).to.have.property(\"bookingid\"); \r",
                  "    pm.expect(jsonData.bookingid).to.not.be.null;\r",
                  "    pm.expect(jsonData.bookingid).to.not.be.undefined;\r",
                  "    pm.expect(jsonData.bookingid).to.not.eql(\"\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate that First name matches request\", function () {\r",
                  "    let responseBody = pm.response.json();\r",
                  "\r",
                  "    pm.expect(responseBody.firstName).to.eql(pm.variables.get(\"{{FirstName}}\"));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate that Last name matches request\", function () {\r",
