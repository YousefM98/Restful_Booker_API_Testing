                  "});\r",
                  "\r",
                  "pm.test(\"Validate that totalprice matches request\", function () {\r",
                  "    let responseBody = pm.response.json();\r",
                  "\r",
                  "    pm.expect(responseBody.totalprice).to.eql(pm.variables.get(\"{{totalprice}}\"));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate that depositpaid matches request\", function () {\r",
                  "    let responseBody = pm.response.json();\r",
                  "\r",
