      "name": "Auth",
      "item": [
        {
          "name": "New Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set(\"token\", pm.response.json().token);\r",
                  "pm.test(\"Validate that the status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Token is present and not empty and contains more than 10 characters\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    \r",
                  "    pm.expect(jsonData).to.have.property(\"token\"); \r",
                  "    pm.expect(jsonData.token).to.not.be.null;\r",
                  "    pm.expect(jsonData.token).to.not.be.undefined;\r",
                  "    pm.expect(jsonData.token).to.not.eql(\"\");\r",
                  "    pm.expect(jsonData.token.length).to.be.greaterThan(10); \r",
                  "});\r",
                  "\r",
                  "pm.test(\"validate that the response time is lower than 500 ms\",function(){\r",
                  "    pm.expect(pm.response.responseTime).to.have.below(500);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
